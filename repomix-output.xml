      setStatus(  !navigator.onLine
    ? "You're currently offline. Please reconnect to the internet and try again."
    : errorMessages[e.code] ?? "Something went wrong. Please try again."); 
    } finally {
      setSubmitting(false); 
    }
  }

  

  const handleSubmit = async () => {
    setVerifying(true); 
    setError(null); 
    try {
