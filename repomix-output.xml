}

.theme-slider-thumb, .turnedOff {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border: 2px solid var(--border-color);
  border-radius: 50%;
  background: var(--button-bg-color);
