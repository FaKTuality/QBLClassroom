        studentName: "Alex Doe",
      },],
      uid: user.uid,
      email: user.email,
      role: "tutor",
      createdAt: serverTimestamp(),
      displayName: name,
    };

    await Promise.all([
      setDoc(doc(db, `admin/${inviteId}`), {
        tutorId: user.uid,
      }),
      setDoc(doc(db, "admin", user.uid), tutorDocument),
    ]);

    navigate("/navtut/tutordashboard");
