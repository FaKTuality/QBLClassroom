  --green: rgb(10, 180, 10); 
}

[data-theme="dark"] {
  --bg-color: rgb(30, 28, 25);
  --text-color: rgb(245, 240, 232);

  --button-bg-color: rgb(74, 62, 48);
  --border-color: rgb(230, 158, 45);
  --button-hover-color: rgb(94, 78, 57);

  --card-color: rgb(58, 53, 47);
