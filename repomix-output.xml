  left: 33px;
}

.turnedOn {
  position: absolute;
  top: 3px;
  left: 33px;
  width: 20px;
  height: 20px;
  border: 2px solid var(--border-color);
  border-radius: 50%;
  background: var(--button-bg-color);  
